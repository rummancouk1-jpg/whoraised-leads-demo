# Provisioned by Vercel's Neon integration. Never put secrets in NEXT_PUBLIC_* variables.
DATABASE_URL=
# Preview/dev fail closed unless both endpoint bindings exist and differ.
GG_DB_ENVIRONMENT=
GG_EXPECTED_DB_HOST=
GG_PRODUCTION_DB_HOST=
GG_ACCESS_PASSWORD=
GG_SESSION_SECRET=
INSTANTLY_API_KEY=
# Optional explicit selection; otherwise only an unambiguous tournament-named campaign is selected.
INSTANTLY_CAMPAIGN_ID=
CRON_SECRET=

# Public redirect destination, server-only; existing query parameters are preserved.
PREREG_URL=https://earningstournament.com

# R2 — outreach layer (all optional; every feature degrades to an honest "not connected" state without them)
# Instantly key additionally needs leads:read and emails:read for per-lead activity (the sync names a missing scope on screen).
# OHQ Watch bearer: OHQ polls /api/ohq/health and /api/ohq/watch with it. Counts-only feed; never put it in NEXT_PUBLIC_*.
OHQ_TOKEN=
# Preregistration site echoes gg_click and signs timestamp.nonce.body with this bearer/HMAC secret.
SIGNUP_WEBHOOK_SECRET=
ATTRIBUTION_SIGNING_SECRET=
# Set (ISO date) when the signup link goes live to start click -> signup attribution; the first reported signup also starts it.
PREREG_LIVE_AT=
# Weekly digest (Monday 9:00 ET). Sending stays OFF unless DIGEST_SEND_ENABLED=true AND the mail settings exist.
DIGEST_SEND_ENABLED=
RESEND_API_KEY=
DIGEST_FROM=
DIGEST_RECIPIENTS=
